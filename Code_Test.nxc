#define LIGHT_LEFT IN_4
#define LIGHT_MID IN_3
#define LIGHT_RIGHT IN_1

#define MOTOR_LEFT OUT_C
#define MOTOR_RIGHT OUT_A
#define MOTOR_MID OUT_B
#define MOTOR_BOTH OUT_AC

// PID Controller constants
#define KP 0.01
#define KI 0.01
#define KD 0.01

struct PID {
    int last_err;
    float output;
    float integral;
};

PID pid_ctrl(int sensor_a, int sensor_b, int dtime, PID pid) {
    int current_err = sensor_a - sensor_b;
    float integral = pid.integral + current_err * dtime;
    float derivative = (dtime > 0) ? ((current_err - pid.last_err) / dtime) : 0;
    float output = KP * current_err + KI * integral + KD * derivative;
    
    PID result;
    result.last_err = current_err;
    result.output = output;
    result.integral = integral;

    return result;
}

int get_light(int port, int cal) {
    const int min = 0;
    const int max = 100;
    
    int real = Sensor(port) - cal;
    int norm = (real - min) * 100 / (max - min);

    return norm;
}

int left_dif = 0;
int mid_dif = 0;
int right_dif = 0;

void calibrate() {
    long end = CurrentTick() + 100;
    while (CurrentTick() < end) {
        left_dif = Sensor(LIGHT_LEFT);
        mid_dif = Sensor(LIGHT_MID);
        right_dif = Sensor(LIGHT_RIGHT);
        Wait(1);
    }
}

void fmt_out(int line, string str, float num) {
    TextOut(0, line, str);
    NumOut((StrLen(str) - 1) * 8, line, num);
}

void print_debug(PID data) {
    ClearScreen();

    // PID debug
    fmt_out(LCD_LINE1, "Output:", data.output);
    fmt_out(LCD_LINE2, "Error:", data.last_err);
    fmt_out(LCD_LINE3, "Integral:", data.integral);

    // Sensors debug
    fmt_out(LCD_LINE5, "Left:", get_light(LIGHT_LEFT, left_dif));
    fmt_out(LCD_LINE6, "Middle:", get_light(LIGHT_MID, mid_dif));
    fmt_out(LCD_LINE7, "Right:", get_light(LIGHT_RIGHT, right_dif));
    // fmt_out(0, LCD_LINE4, "Distance:", SensorUS(IN_2));
}

int clip(int val, int min, int max) {
    if (val < min)
        return min;
    if (val > max)
        return max;
    return val;
}

void turn() {
    long end_time = CurrentTick() + 1600;
    while (end_time - CurrentTick() > 0) {
        OnFwd(MOTOR_LEFT, 40);
        OnFwd(MOTOR_RIGHT, -40);
    }
}

task main() {
    SetSensorLight(LIGHT_LEFT);
    // SetSensorLight(LIGHT_MID);
    SetSensorLight(LIGHT_RIGHT);
    calibrate();
    // ultra sound sensor
    SetSensorLowspeed(IN_2);

    long last_time = CurrentTick();
    const int base_speed = 50;
    
    PID steering;
    steering.output = 0;
    steering.last_err = 0;
    steering.integral = 0;

    while(true) {
        long current_time = CurrentTick();
        int dtime = current_time - last_time;
        last_time = current_time; 

        int left = get_light(LIGHT_LEFT, left_dif);
        int right =  get_light(LIGHT_RIGHT, right_dif);
        steering = pid_ctrl(left, right, dtime, steering);

        // react on steering data
        if (steering.output < 100 && steering.output > -100) {
            OnFwd(MOTOR_BOTH, base_speed);
        } else {
            OnFwd(MOTOR_LEFT, clip(base_speed - steering.output, 10, 80));
            OnFwd(LIGHT_RIGHT, clip(base_speed + steering.output, 10, 80));
        }

        print_debug(steering);
        Wait(100);
    }
}