#define LEFT_LIGHT IN_4
#define MID_LIGHT IN_3
#define RIGHT_LIGHT IN_1

#define LEFT_MOTOR OUT_C
#define RIGHT_MOTOR OUT_B

#define KP 0.01
#define KI 0.001
#define KD 0.01

struct Test {
    float output;
    int err;
    float integral;
};

Test pid_ctrl(int sensor_a, int sensor_b, float prev_err, float integral, float dt) {
    float err = sensor_a - sensor_b;
    integral += err * dt;
    float derivative = (dt > 0) ? ((err - prev_err) / dt) : 0;
    float output = KP * err + KI * integral + KD * derivative;
    Test o;
    o.output = output;
    o.err = err;
    o.integral = integral;
    return o;
}

int get_light(int port, int cal) {
    return Sensor(port) - cal;
}

int left_dif = 0;
int mid_dif = 0;
int right_dif = 0;

int min(int a, int b) {return (a < b) ? a : b;}

void calibrate() {
    long end = CurrentTick() + 2000;
    while (CurrentTick() < end) {
        left_dif = Sensor(LEFT_LIGHT);
        mid_dif = Sensor(MID_LIGHT);
        right_dif = Sensor(RIGHT_LIGHT);
        Wait(1);
    }
}

task main() {
    SetSensorLight(LEFT_LIGHT);
    SetSensorLight(MID_LIGHT);
    SetSensorLight(RIGHT_LIGHT);
    // calibrate lights to relative 0
    calibrate();

    // ultra sound sensor
    SetSensorLowspeed(IN_2);

    float prev_error = 0.0;
    float integral = 0.0;
    long last_time = CurrentTick();
    int base_speed = 10;

    while(true) {
        ClearScreen();
        long current_time = CurrentTick();
        float dt = current_time - last_time;
        last_time = current_time; 

        Test data = pid_ctrl(get_light(LEFT_LIGHT, left_dif), get_light(RIGHT_LIGHT, right_dif), prev_error, integral, dt);
        
        prev_error = data.err;
        integral = data.integral;

        OnRev(LEFT_MOTOR, min(base_speed - data.output, 0));
        OnRev(RIGHT_MOTOR, min(base_speed + data.output, 0));

        NumOut(60, LCD_LINE5, data.output);
        NumOut(60, LCD_LINE6, integral);
        NumOut(69, LCD_LINE7, prev_error);
        NumOut(60, LCD_LINE8, dt);

        TextOut(0, LCD_LINE1, "Left:");
        NumOut(60, LCD_LINE1, get_light(LEFT_LIGHT, left_dif));
        TextOut(0, LCD_LINE2, "Middle:");
        NumOut(60, LCD_LINE2, get_light(MID_LIGHT, mid_dif));
        TextOut(0, LCD_LINE3, "Right:");
        NumOut(60, LCD_LINE3, get_light(RIGHT_LIGHT, right_dif));

        TextOut(0, LCD_LINE4, "Distance:");
        NumOut(60, LCD_LINE4, SensorUS(IN_2));
        
        Wait(SEC_1);


    }
}