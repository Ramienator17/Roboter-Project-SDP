#define LIGHT_LEFT IN_4
#define LIGHT_MID IN_3
#define LIGHT_RIGHT IN_1

#define MOTOR_LEFT OUT_C
#define MOTOR_RIGHT OUT_A
#define MOTOR_MID OUT_B
#define MOTOR_BOTH OUT_AC

// constants for PID controller
#define KP 10
#define KI 0.01
#define KD 10

struct PID {
    int last_err;
    float output;
    float integral;
};

PID pid_ctrl(int sensor_a, int sensor_b, int dtime, PID pid) {
    int current_err = sensor_a - sensor_b;
    float integral = pid.integral + current_err * dtime;
    float derivative = (dtime > 0) ? ((current_err - pid.last_err) / dtime) : 0;
    float output = KP * current_err + KI * integral + KD * derivative;
    
    PID result;
    result.last_err = current_err;
    result.output = output;
    result.integral = integral;

    return result;
}

int get_light(int port, int cal) {
    const int min = 0;
    const int max = 100;
    
    int real = Sensor(port) - cal;
    int norm = (real - min) * 100 / (max - min);

    return norm;
}

int left_dif = 0;
int mid_dif = 0;
int right_dif = 0;

void calibrate() {
    long end = CurrentTick() + 1000;
    while (CurrentTick() < end) {
        left_dif = Sensor(LIGHT_LEFT);
        mid_dif = Sensor(LIGHT_MID);
        right_dif = Sensor(LIGHT_RIGHT);
        Wait(1);
    }
}

void print_debug(PID data, float dt) {
    ClearScreen();

    TextOut(0, LCD_LINE5, fmt("output: ", data.output));
    //TextOut(0, LCD_LINE6, FormatNum("err: %d", data.last_err));
    //TextOut(0, LCD_LINE7, FormatNum("integral: %f", data.integral));
    Flatten(5); 

    TextOut(0, LCD_LINE1, "Left:");
    NumOut(60, LCD_LINE1, get_light(LIGHT_LEFT, left_dif));
    TextOut(0, LCD_LINE2, "Middle:");
    NumOut(60, LCD_LINE2, get_light(LIGHT_MID, mid_dif));
    TextOut(0, LCD_LINE3, "Right:");
    NumOut(60, LCD_LINE3, get_light(LIGHT_RIGHT, right_dif));
    /*
    TextOut(0, LCD_LINE4, "Distance:");
    NumOut(60, LCD_LINE4, SensorUS(IN_2));
    */
}

int clip(int val, int min, int max) {
    if (val < min)
        return min;
    if (val > max)
        return max;
    return val;
}

task main() {
    SetSensorLight(LIGHT_LEFT);
    // SetSensorLight(LIGHT_MID);
    SetSensorLight(LIGHT_RIGHT);
    calibrate();
    // ultra sound sensor
    SetSensorLowspeed(IN_2);

    long last_time = CurrentTick();
    const int base_speed = 50;
    
    PID steering;
    steering.output = 0;
    steering.last_err = 0;
    steering.integral = 0;

    while(true) {
        long current_time = CurrentTick();
        int dtime = current_time - last_time;
        last_time = current_time; 

        steering = pid_ctrl(get_light(LIGHT_LEFT, left_dif), get_light(LIGHT_RIGHT, right_dif), dtime, steering);

        // react on steering data
        OnFwd(MOTOR_LEFT, clip(base_speed - steering.output, 0, 30));
        OnFwd(LIGHT_RIGHT, clip(base_speed + steering.output, 0, 30));
        
        print_debug(steering, dtime);
        Wait(10);
    }
}